{
	"version": 4,
	"configurations": [
		{
			"name": "Linux (Debug)",
			"includePath": [
				"${workspaceFolder}/build/_deps/spdlog-src/include",
				"${workspaceFolder}/build/_deps/glfw-src/include",
				"${workspaceFolder}/build/_deps/glm-src",
				"${workspaceFolder}/build/_deps/entt-src/src",
				"${workspaceFolder}/Game/glad/include",
				"${workspaceFolder}/Game/include",
				"/usr/include",
				"/usr/local/include"
			],
			"defines": [
				"DEBUG",
				"GLFW_INCLUDE_NONE",
				"LOGGING_ENABLED",
				"ASSERTS_ENABLED"
			],
			"compilerPath": "/usr/bin/g++",
			"cStandard": "c17",
			"cppStandard": "c++17",
			"intelliSenseMode": "linux-gcc-x64"
		}
	]
}
